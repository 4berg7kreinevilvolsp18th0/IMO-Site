# Локальная разработка (backend/)
# Скопируйте в .env и заполните

# Обязательно в production
SECRET_KEY=your-secret-key-min-50-chars

# Path A (Vercel serverless) / Path B (CMS отдельно)
# DJANGO_SETTINGS_MODULE=mysite.settings.prod
# ALLOWED_HOSTS=.vercel.app,yourdomain.tld
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Медиа в S3/R2 (опционально)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=  # для R2

# Wagtail
# WAGTAILADMIN_BASE_URL=https://cms.yourdomain.tld
# WAGTAILAPI_BASE_URL=https://cms.yourdomain.tld
